    {
      "name": "Auth",
      "item": [
        {
          "name": "Login — Valid Credentials",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status is 200\", () =>",
                  "{",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Response time under 2000 ms\", () =>",
                  "{",
                  "    pm.expect(pm.response.responseTime).to.be.below(2000);",
                  "});",
                  "",
                  "pm.test(\"Response body contains id field\", () =>",
                  "{",
                  "    const body = pm.response.json();",
                  "    pm.expect(body).to.have.property(\"id\");",
                  "});",
                  "",
                  "pm.test(\"Set environment variable for Customer id\", () =>",
                  "{   ",
                  "    const body = pm.response.json();",
                  "    if(pm.response.code === 200 && body.id) {",
                  "        pm.environment.set(\"customer_id\", body.id);",
                  "        pm.expect(pm.environment.get(\"customer_id\")).to.eql(body.id);",
                  "    }",
                  "    else {",
                  "        pm.expect.fail(\"Login failed - customer id not saved. Subsequent tests might fail\");",
                  "    }",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            },
            {
              "listen": "prerequest",
              "script": {
